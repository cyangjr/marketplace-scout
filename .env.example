# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_ALLOWED_USER_IDS=

# LLMs (free tiers)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Home defaults
HOME_ZIP=10001
DEFAULT_MAX_MILES=25
DEFAULT_POLL_MINUTES=15

# App
DATABASE_PATH=data/scout.db
PLAYWRIGHT_PROFILE_DIR=data/playwright_profile
HOST=127.0.0.1
PORT=8765
CONFIDENCE_ALERT_THRESHOLD=0.75
CONFIDENCE_AMBIGUOUS_LOW=0.4
CONFIDENCE_AMBIGUOUS_HIGH=0.75

# Facebook pacing / circuit breaker
FB_POLL_MINUTES=30
FB_STAGGER_SECONDS=45
FB_CIRCUIT_HOURS=12
FB_HEADLESS=true
FB_TIMEZONE=America/New_York
FB_WAIT_MIN_SECONDS=2
FB_WAIT_MAX_SECONDS=6
FB_MAX_RESULTS=25

# Craigslist public HTML search (paged results + posting bodies after tier-1)
CL_MAX_PAGES=3
CL_MAX_RESULTS=120
CL_DETAIL_LIMIT=15
CL_DETAIL_DELAY_SECONDS=0.4
